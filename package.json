{
    "name": "show-scheduler",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "wasm-pack build --dev --target web --out-dir ../src/lib/wasm rust && vite dev",
        "build": "wasm-pack build --release --target web --out-dir ../src/lib/wasm rust && vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.57.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "svelte": "^5.55.2",
        "svelte-check": "^4.4.6",
        "typescript": "^6.0.2",
        "vite": "^8.0.7"
    }
}
